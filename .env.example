# AWS credentials resolve via the normal boto3 chain (aws configure / env vars / IAM role) --
# nothing AWS-secret goes in this file. These are non-secret resource identifiers only.

AWS_REGION=us-east-1

# Amazon SES (sesv2) -- must be a verified sender identity in your SES account.
OMNIDAMUS_SES_FROM_ADDRESS=

# AWS End User Messaging (pinpoint-sms-voice-v2) -- an origination identity: either a
# phone pool ID (supports SMS + RCS with SMS fallback) or an RCS Agent ARN (RCS-only,
# direct send). See docs/ARCHITECTURE.md for the three sending patterns.
OMNIDAMUS_SMS_RCS_ORIGINATION_IDENTITY=
OMNIDAMUS_SMS_RCS_CONFIGURATION_SET=

# AWS End User Messaging Social (socialmessaging) -- the linked WhatsApp Business
# Account phone number ID (format: phone-number-id-... or an ARN).
OMNIDAMUS_WHATSAPP_ORIGINATION_PHONE_NUMBER_ID=
OMNIDAMUS_WHATSAPP_META_API_VERSION=v20.0

# Amazon Bedrock model ID used by the Strands agent.
OMNIDAMUS_BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
